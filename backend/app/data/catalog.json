{
  "hair_types": [
    { "code": "1A", "family": "Straight", "description": "Fine, completely straight, and hard to curl." },
    { "code": "1B", "family": "Straight", "description": "Straight with a little body and some bend at the ends." },
    { "code": "1C", "family": "Straight", "description": "Straight but coarser, with a slight bend and some frizz." },
    { "code": "2A", "family": "Wavy", "description": "Loose, barely-there S-waves that sit close to the head." },
    { "code": "2B", "family": "Wavy", "description": "Defined S-waves from the mid-lengths down, with some frizz on top." },
    { "code": "2C", "family": "Wavy", "description": "Thick, well-defined waves that start near the roots." },
    { "code": "3A", "family": "Curly", "description": "Large, loose spirals about the width of sidewalk chalk." },
    { "code": "3B", "family": "Curly", "description": "Springy ringlets about the width of a marker." },
    { "code": "3C", "family": "Curly", "description": "Tight corkscrews about the width of a pencil or straw." },
    { "code": "4A", "family": "Coily", "description": "Dense, springy S-shaped coils about the width of a crochet needle." },
    { "code": "4B", "family": "Coily", "description": "Tightly packed coils that bend in sharp, Z-shaped angles." },
    { "code": "4C", "family": "Coily", "description": "The tightest coils, with a zigzag pattern and the most shrinkage." }
  ],

  "ingredients": [
    { "id": "water", "name": "Water", "inci": "Aqua", "function": "Solvent", "is_base": true,
      "what_it_does": "The base that dissolves and carries everything else.",
      "why_its_added": "Most creams, shampoos, and conditioners are mostly water. It lets the other ingredients spread evenly through your hair." },
    { "id": "glycerin", "name": "Glycerin", "inci": "Glycerin", "function": "Humectant",
      "what_it_does": "Pulls water from the air into your hair.",
      "why_its_added": "Keeps hair hydrated between washes. Can feel sticky in very humid or very dry weather." },
    { "id": "aloe", "name": "Aloe vera juice", "inci": "Aloe Barbadensis Leaf Juice", "function": "Humectant",
      "what_it_does": "Hydrates hair and soothes the scalp. Slightly acidic.",
      "why_its_added": "Adds lightweight moisture and helps smooth the outer layer of each strand." },
    { "id": "shea", "name": "Shea butter", "inci": "Butyrospermum Parkii (Shea) Butter", "function": "Emollient",
      "what_it_does": "A rich plant butter that coats and softens strands.",
      "why_its_added": "Seals in moisture and reduces breakage, especially in thick or coily hair." },
    { "id": "mango", "name": "Mango butter", "inci": "Mangifera Indica Seed Butter", "function": "Emollient",
      "what_it_does": "A lighter butter than shea that melts on contact with skin.",
      "why_its_added": "Softens and seals with less heaviness than shea." },
    { "id": "coconut", "name": "Coconut oil", "inci": "Cocos Nucifera Oil", "function": "Emollient",
      "what_it_does": "One of the few oils that can soak into the hair shaft.",
      "why_its_added": "Reduces protein loss during washing. Some coarse hair feels stiff with it." },
    { "id": "jojoba", "name": "Jojoba oil", "inci": "Simmondsia Chinensis Seed Oil", "function": "Emollient",
      "what_it_does": "A liquid wax that closely resembles your scalp's natural oil.",
      "why_its_added": "Adds shine and light conditioning without feeling greasy." },
    { "id": "argan", "name": "Argan oil", "inci": "Argania Spinosa Kernel Oil", "function": "Emollient",
      "what_it_does": "A light oil rich in vitamin E and fatty acids.",
      "why_its_added": "Adds shine and softness and tames frizz." },
    { "id": "castor", "name": "Castor oil", "inci": "Ricinus Communis Seed Oil", "function": "Emollient",
      "what_it_does": "A very thick, sticky oil.",
      "why_its_added": "Seals moisture, gives edges hold, and makes products feel richer." },
    { "id": "avocado", "name": "Avocado oil", "inci": "Persea Gratissima Oil", "function": "Emollient",
      "what_it_does": "A rich oil full of fatty acids that soften strands.",
      "why_its_added": "Conditions dry hair and adds slip." },
    { "id": "beeswax", "name": "Beeswax", "inci": "Cera Alba", "function": "Film former",
      "what_it_does": "A natural wax that stiffens as it cools.",
      "why_its_added": "Holds hair in place and seals edges and ends." },
    { "id": "cetearyl", "name": "Cetearyl alcohol", "inci": "Cetearyl Alcohol", "function": "Fatty alcohol",
      "what_it_does": "A waxy, non-drying alcohol made from plant fats.",
      "why_its_added": "Thickens creams and makes hair feel soft. Unlike drying alcohols, it doesn't strip moisture." },
    { "id": "btms", "name": "BTMS", "inci": "Behentrimonium Methosulfate", "function": "Conditioning agent",
      "what_it_does": "A gentle conditioner that clings to damaged spots on the hair.",
      "why_its_added": "Gives slip for detangling. Despite the name, it isn't a sulfate." },
    { "id": "cetrimonium", "name": "Cetrimonium chloride", "inci": "Cetrimonium Chloride", "function": "Conditioning agent",
      "what_it_does": "A positively charged conditioner that cancels static.",
      "why_its_added": "Makes detangling easier and calms frizz." },
    { "id": "wheat_protein", "name": "Hydrolyzed wheat protein", "inci": "Hydrolyzed Wheat Protein", "function": "Protein",
      "what_it_does": "Small protein pieces that patch gaps in the hair's surface.",
      "why_its_added": "Strengthens damaged hair. Too much can leave hair stiff or brittle." },
    { "id": "rice_protein", "name": "Hydrolyzed rice protein", "inci": "Hydrolyzed Rice Protein", "function": "Protein",
      "what_it_does": "A light plant protein that adds body.",
      "why_its_added": "Strengthens and thickens fine strands without heavy buildup." },
    { "id": "rice_water", "name": "Fermented rice water", "inci": "Lactobacillus/Rice Ferment Filtrate", "function": "Protein",
      "what_it_does": "Water left from fermenting rice, carrying starches and amino acids.",
      "why_its_added": "Strengthens strands and adds smoothness." },
    { "id": "panthenol", "name": "Panthenol", "inci": "Panthenol", "function": "Humectant",
      "what_it_does": "Provitamin B5. Holds onto water and adds shine.",
      "why_its_added": "Boosts moisture and makes strands feel thicker." },
    { "id": "honey", "name": "Honey", "inci": "Mel", "function": "Humectant",
      "what_it_does": "Draws in moisture and softens.",
      "why_its_added": "Adds hydration and shine." },
    { "id": "flaxseed", "name": "Flaxseed extract", "inci": "Linum Usitatissimum Seed Extract", "function": "Film former",
      "what_it_does": "A natural gel made from flax seeds.",
      "why_its_added": "Gives soft, flexible hold and curl definition." },
    { "id": "marshmallow", "name": "Marshmallow root extract", "inci": "Althaea Officinalis Root Extract", "function": "Slip agent",
      "what_it_does": "A plant extract that turns slippery in water.",
      "why_its_added": "Helps fingers and combs glide through knots." },
    { "id": "sci", "name": "Sodium cocoyl isethionate", "inci": "Sodium Cocoyl Isethionate", "function": "Cleanser",
      "what_it_does": "A mild cleanser made from coconut fatty acids.",
      "why_its_added": "Cleans hair and scalp with less stripping than sulfates." },
    { "id": "capb", "name": "Cocamidopropyl betaine", "inci": "Cocamidopropyl Betaine", "function": "Cleanser",
      "what_it_does": "A gentle co-cleanser that boosts lather.",
      "why_its_added": "Softens harsher cleansers and makes shampoo feel creamier." },
    { "id": "decyl", "name": "Decyl glucoside", "inci": "Decyl Glucoside", "function": "Cleanser",
      "what_it_does": "A very mild cleanser made from sugar.",
      "why_its_added": "Cleans gently in co-washes and low-lather shampoos." },
    { "id": "xanthan", "name": "Xanthan gum", "inci": "Xanthan Gum", "function": "Thickener",
      "what_it_does": "A natural gum that thickens liquids.",
      "why_its_added": "Gives gels and creams their texture and keeps them from separating." },
    { "id": "guar", "name": "Guar conditioner", "inci": "Guar Hydroxypropyltrimonium Chloride", "function": "Conditioning agent",
      "what_it_does": "A conditioning ingredient made from guar beans.",
      "why_its_added": "Leaves a light conditioning film behind after rinsing." },
    { "id": "rosemary", "name": "Rosemary leaf extract", "inci": "Rosmarinus Officinalis Leaf Extract", "function": "Scalp care",
      "what_it_does": "An herbal extract with a fresh scent.",
      "why_its_added": "Gives a soothing, refreshing feel on the scalp." },
    { "id": "tea_tree", "name": "Tea tree oil", "inci": "Melaleuca Alternifolia Leaf Oil", "function": "Scalp care",
      "what_it_does": "An essential oil with a sharp, medicinal scent.",
      "why_its_added": "Helps with flaking and itchy scalp. Can irritate in high amounts." },
    { "id": "apple_cider", "name": "Apple cider vinegar", "inci": "Pyrus Malus Fruit Vinegar", "function": "pH adjuster",
      "what_it_does": "A mild fruit acid.",
      "why_its_added": "Clears buildup and leaves hair smoother and shinier." },
    { "id": "alcohol_denat", "name": "Denatured alcohol", "inci": "Alcohol Denat.", "function": "Solvent",
      "what_it_does": "A quick-evaporating alcohol.",
      "why_its_added": "Helps foams and sprays dry fast. Can be drying if it's high on the list." },
    { "id": "phenoxyethanol", "name": "Phenoxyethanol", "inci": "Phenoxyethanol", "function": "Preservative",
      "what_it_does": "Stops bacteria and mold from growing in the product.",
      "why_its_added": "Needed in any water-based product so it stays safe after you open it." },
    { "id": "citric", "name": "Citric acid", "inci": "Citric Acid", "function": "pH adjuster",
      "what_it_does": "A mild acid from citrus fruit.",
      "why_its_added": "Keeps the product at a hair-friendly pH, which helps strands lie flat and look shiny." },
    { "id": "fragrance", "name": "Fragrance", "inci": "Parfum", "function": "Fragrance",
      "what_it_does": "A blend of scent ingredients.",
      "why_its_added": "Adds scent. Brands don't have to list what's in it, which matters if your scalp is sensitive." }
  ],

